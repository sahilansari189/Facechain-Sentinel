# ============================================================
# Reverse image search
# ============================================================
# Which provider to use: serpapi | bing | tineye
SEARCH_PROVIDER=serpapi

# SerpApi key (Google Lens engine) -> https://serpapi.com/manage-api-key
# Free tier: 100 searches / month.
SEARCH_API_KEY=

# Bing Visual Search key (only if SEARCH_PROVIDER=bing)
# Azure portal -> Bing Search v7 resource.
BING_VISUAL_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/images/visualsearch

# TinEye API credentials (only if SEARCH_PROVIDER=tineye)
TINEYE_API_URL=https://api.tineye.com/rest/search/
TINEYE_API_KEY=

# The input image must be reachable by the search provider.
# Either pass --image-url, or configure a public upload endpoint (0x0.st style).
IMAGE_UPLOAD_URL=https://0x0.st

# ============================================================
# Face pipeline
# ============================================================
FACE_MODEL=buffalo_l
FACE_DET_SIZE=640
# Cosine-similarity threshold. EMPIRICAL and model dependent (see README).
MATCH_THRESHOLD=0.45
MAX_CANDIDATES=20
MAX_IMAGE_BYTES=8388608
HTTP_TIMEOUT=15

# ============================================================
# Batch processing (50-100+ images)
# ============================================================
# Parallel worker threads. Network-bound stages dominate, so 8-16 is usually
# the sweet spot; raise it only if your search provider allows the QPS.
BATCH_WORKERS=8
# Concurrent InsightFace sessions (~300 MB RAM each). 0 = auto (cpu_count/2, max 4).
FACE_POOL_SIZE=0
# Verified fingerprints anchored per blockchain transaction.
BATCH_CHUNK_SIZE=25

# ============================================================
# Blockchain (Ethereum Sepolia testnet)
# ============================================================
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111
PRIVATE_KEY=
CONTRACT_ADDRESS=
EXPLORER_BASE=https://sepolia.etherscan.io
