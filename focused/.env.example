# ============================================================
# Reverse image search
# ============================================================
# Which provider to use: serpapi | bing | tineye | cascade
SEARCH_PROVIDER=serpapi
SEARCH_FALLBACKS=headless_lens,yandex
SEARCH_CONTEXT=

# SerpApi key (Google Lens engine) -> https://serpapi.com/manage-api-key
# Free tier: 100 searches / month.
SEARCH_API_KEY=
SERPAPI_KEY=

# Headless Google Lens / Chromium fallback settings
LENS_HEADLESS=true
LENS_TIMEOUT=25.0
CHROMIUM_PATH=

# Bing Visual Search key (only if SEARCH_PROVIDER=bing)
# Azure portal -> Bing Search v7 resource.
BING_VISUAL_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/images/visualsearch

# TinEye API credentials (only if SEARCH_PROVIDER=tineye)
TINEYE_API_URL=https://api.tineye.com/rest/search/
TINEYE_API_KEY=

# The input image must be reachable by the search provider.
# Either pass --image-url, or configure a public upload endpoint (e.g. https://0x0.st).
IMAGE_UPLOAD_URL=https://0x0.st

# Browser origins allowed to call the API. Comma-separated for custom domains.
CORS_ORIGINS=http://localhost:5173

# ============================================================
# Face pipeline
# ============================================================
FACE_MODEL=buffalo_l
FACE_DET_SIZE=640
FACE_DEVICE=auto
# Cosine-similarity threshold. EMPIRICAL and model dependent (see README).
MATCH_THRESHOLD=0.45
MAX_CANDIDATES=20
MAX_IMAGE_BYTES=8388608
HTTP_TIMEOUT=15

# ============================================================
# Identity pivot & username sweeps (OSINT)
# ============================================================
PIVOT_ENABLED=true
PIVOT_ENGINE=wmn
PIVOT_MAX_SITES=300
PIVOT_TIMEOUT=8.0
# Upper bound for an entire username sweep. A partial result is returned when
# the limit is reached, so an unresponsive site cannot stall a face search.
PIVOT_SWEEP_TIMEOUT=30.0
PIVOT_MAX_WORKERS=12
PIVOT_MAX_ACCOUNTS=25
PIVOT_MAX_CANDIDATES=50
PIVOT_BROWSER_FALLBACK=false
# Include lower-priority public sites from an installed WhatsMyName catalogue.
PIVOT_EXHAUSTIVE=false

# ============================================================
# Batch processing (50-100+ images)
# ============================================================
# Parallel worker threads. Network-bound stages dominate, so 8-16 is usually
# the sweet spot; raise it only if your search provider allows the QPS.
BATCH_WORKERS=8
# Concurrent InsightFace sessions (~300 MB RAM each). 0 = auto (cpu_count/2, max 4).
FACE_POOL_SIZE=1
# Verified fingerprints anchored per blockchain transaction.
BATCH_CHUNK_SIZE=25

# ============================================================
# Blockchain (Ethereum Sepolia testnet)
# ============================================================
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111
PRIVATE_KEY=
CONTRACT_ADDRESS=
EXPLORER_BASE=https://sepolia.etherscan.io
